# This file intentionally does not come with signatures.  Put your local
# additions here.
alert tcp any any -> $HOME_NET any (msg:"Port Scan Detected"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000001; rev:1;)

alert icmp any any -> $HOME_NET any (msg:"ICMP Flood Detected"; threshold:type both, track by_src, count 10, seconds 1; sid:1000002; rev:1;)

alert tcp any any -> $HOME_NET 22 (msg:"Possible SSH Brute Force"; threshold:type both, track by_src, count 3, seconds 30; sid:1000005; rev:1;)



