# OpenSSL Configuration File for Self-Signed Certificate
# This file defines the parameters for generating a self-signed SSL certificate

[ req ]
default_bits       = 2048                    # RSA key size
default_keyfile    = server-key.pem          # Default key file name
distinguished_name = req_distinguished_name  # Section for certificate details
req_extensions     = v3_req                  # Extensions for certificate request
x509_extensions    = v3_ca                   # Extensions for self-signed cert
prompt             = no                      # Don't prompt for values

# Distinguished Name - Certificate Identity Information
[ req_distinguished_name ]
C  = IN                                      # Country Name (2 letter code)
ST = Maharashtra                             # State or Province Name
L  = Mumbai                                  # Locality Name (city)
O  = Student Organization                    # Organization Name
OU = IT Department                           # Organizational Unit Name
CN = localhost                               # Common Name (server FQDN)
emailAddress = admin@localhost.local         # Email Address

# Extensions for certificate requests
[ v3_req ]
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName = @alt_names

# Extensions for self-signed certificates
[ v3_ca ]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true
keyUsage = critical, digitalSignature, cRLSign, keyCertSign
subjectAltName = @alt_names

# Subject Alternative Names - Important for modern browsers
[ alt_names ]
DNS.1 = localhost
DNS.2 = *.localhost
IP.1 = 127.0.0.1
IP.2 = ::1
